rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funciones auxiliares de autenticación y roles
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().rol == role;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isKitchen() {
      return hasRole('kitchen') || isAdmin();
    }
    
    function isMedical() {
      return hasRole('nutrition_or_medical') || isAdmin();
    }
    
    function isTeacherOfGroup(etapa, curso, letra) {
      return hasRole('teacher') && (
        getUserData().gruposAsignados.hasAny([etapa + '_' + curso + '_' + letra]) ||
        getUserData().esProfesorGlobal == true
      );
    }

    // 1. Colección de Usuarios y Asignaciones
    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // 2. Registros Diarios de Asistencia
    match /registros_diarios/{registroId} {
      // Cocina y Admin pueden leer cualquier registro
      // Profesores solo leen los registros de sus grupos
      allow read: if isAuthenticated() && (
        isKitchen() || 
        isTeacherOfGroup(resource.data.etapa, resource.data.curso, resource.data.letra)
      );
      
      // Creación: Solo profesor asignado al grupo o admin, validando inmutabilidad del autor
      allow create: if isAuthenticated() && (
        isAdmin() || (
          hasRole('teacher') &&
          request.resource.data.autorUid == request.auth.uid &&
          isTeacherOfGroup(request.resource.data.etapa, request.resource.data.curso, request.resource.data.letra)
        )
      );
      
      // Actualización: Solo autor o admin, sin alterar campos inmutables (autorUid, createdAt)
      allow update: if isAuthenticated() && (
        isAdmin() || (
          hasRole('teacher') &&
          resource.data.autorUid == request.auth.uid &&
          request.resource.data.autorUid == resource.data.autorUid &&
          request.resource.data.createdAt == resource.data.createdAt
        ) || (
          hasRole('kitchen') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoCocina', 'confirmadoPorCocinaAt'])
        )
      );
      
      allow delete: if isAdmin();
    }

    // 3. Roster de Alumnos con Dietas Especiales (Datos Operativos para Comedor)
    match /alumnos_especiales/{alumnoId} {
      allow read: if isAuthenticated();
      allow write: if isMedical();
    }

    // 4. Datos Médicos Clínicos y Contactos (Datos Sensibles RGPD - Solo Médico/Admin)
    match /alumnos_clinicos/{alumnoId} {
      allow read, write: if isMedical();
    }

    // 5. Configuración General del Centro
    match /configuracion/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Totales Diarios Consolidados
    match /totales_diarios/{fechaId} {
      allow read: if isAuthenticated() && (isKitchen() || isAdmin());
      allow write: if isKitchen() || isAdmin();
    }

    // 7. Registro de Auditoría (Append-Only inmutable)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Inmutable
    }
  }
}
